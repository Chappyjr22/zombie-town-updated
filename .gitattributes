# Godot always writes these as LF regardless of platform. core.autocrlf=true
# on Windows was flagging them as modified on every checkout even when byte-
# identical to what's committed - force LF so git stops fighting Godot.
*.import text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
project.godot text eol=lf
